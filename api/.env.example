# Use a Supabase PostgreSQL connection string for persistent hosted data.
# Prefer the provider's connection pooler if your host has IPv4-only networking.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_HOST:5432/postgres
# Exact origin(s) allowed to call the API, comma-separated. No trailing slash.
CORS_ORIGINS=https://YOUR-USERNAME.github.io
# Optional local SQLite path; used only when DATABASE_URL is empty.
SQLITE_PATH=./data/economic_intel.db
